{
  "name": "htmx-echarts",
  "version": "4.0.0-beta5",
  "description": "htmx 4 extension connecting htmx, Apache ECharts and SSE for live-updating charts",
  "license": "MIT",
  "author": "Marcin Golenia",
  "keywords": [
    "htmx",
    "htmx-extension",
    "echarts",
    "charts",
    "sse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcingolenia/htmx-echarts.git"
  },
  "homepage": "https://github.com/marcingolenia/htmx-echarts#readme",
  "bugs": "https://github.com/marcingolenia/htmx-echarts/issues",
  "main": "dist/htmx-echarts.min.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/htmx-echarts.min.js",
    "./dist/htmx-echarts.js": "./dist/htmx-echarts.js"
  },
  "scripts": {
    "dev": "bun --hot index.tsx",
    "build": "bun run build:min && bun run build:dev",
    "build:min": "bun build ./static/htmx-echarts.js --outfile=./dist/htmx-echarts.min.js --minify --target=browser --banner=\"// htmx-echarts (htmx 4) -- https://github.com/marcingolenia/htmx-echarts\"",
    "build:dev": "bun build ./static/htmx-echarts.js --outfile=./dist/htmx-echarts.js --target=browser --banner=\"// htmx-echarts (htmx 4) -- https://github.com/marcingolenia/htmx-echarts\"",
    "test": "bun test",
    "prepublishOnly": "bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.3.12",
    "echarts": "^6.0.0",
    "hono": "^4.12.3",
    "typescript": "^5"
  },
  "peerDependencies": {
    "htmx.org": "^4.0.0-beta5"
  }
}
